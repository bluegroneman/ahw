---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.svelte';
---

<Layout title="Application Received | Almost Home Wyoming">
  <meta slot="head" name="robots" content="noindex" />
  <Hero headline="Application Received" body="Thank you for reaching out to Almost Home Wyoming." />
  <section aria-labelledby="confirmation-heading" class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-10">
      <h2 id="confirmation-heading" class="text-2xl font-bold text-gray-900">Your application has been submitted</h2>
      <p class="mt-4 leading-7 text-gray-600">Almost Home Wyoming will review your application and any documents you included. Submitting an application does not guarantee assistance.</p>
      <p class="mt-4 leading-7 text-gray-600">If you have questions, call <a class="text-t-blue underline" href="tel:+13074383332">(307) 438-3332</a>.</p>
      <a href="/contact" class="mt-6 inline-flex rounded-md bg-t-blue px-5 py-3 font-semibold text-white hover:bg-slate-700">Return to Contact</a>
    </div>
  </section>
</Layout>
